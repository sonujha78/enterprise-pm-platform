          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": { "raw": "{{baseUrl}}/dashboard/tasks-by-status", "host": ["{{baseUrl}}"], "path": ["dashboard", "tasks-by-status"] }
          }
        },
        {
          "name": "Tasks by Priority",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": { "raw": "{{baseUrl}}/dashboard/tasks-by-priority", "host": ["{{baseUrl}}"], "path": ["dashboard", "tasks-by-priority"] }
          }
        },
        {
          "name": "Workload",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": { "raw": "{{baseUrl}}/dashboard/workload", "host": ["{{baseUrl}}"], "path": ["dashboard", "workload"] }
